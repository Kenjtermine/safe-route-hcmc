# Cách dùng: cp .env.example .env   (KHÔNG commit file .env)
#
# Lưu ý: DB_PASSWORD được ghép vào chuỗi kết nối, nên tránh các ký tự đặc biệt
# như @ : / # ? trong mật khẩu khi chạy local.

# --- PostgreSQL / PostGIS / pgRouting ---
DB_USER=saferoute
DB_PASSWORD=change_me
DB_NAME=saferoute
# Cổng DB mở ra máy host (đổi nếu trùng với Postgres đang cài sẵn)
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
APP_ENV=local
LOG_LEVEL=info

# --- Frontend ---
FRONTEND_PORT=5173

# --- (Tuỳ chọn) đổi image DB nếu tag mặc định không pull được ---
# DB_IMAGE=nickblah/pgrouting:16-bookworm-postgis-3.6-pgrouting-4.0.1
